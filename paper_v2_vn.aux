\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Hit@10 thử nghiệm của HAN cho cả 24 tập meta-path, mỗi tập một seed (độ lệch chuẩn qua ba seed của các tập chính nhiều nhất là \val  {han-m6-hit-sd}). Ở seed này, các tập tìm được đứng cuối trong số các tập lấy từ cùng \val  {search-cands} ứng viên ở cả hai kích thước, dù với chênh lệch nằm trong nhiễu giữa các seed. M5 và M6 nằm gần giữa các tập chọn ngẫu nhiên. Để so sánh: mô hình phổ biến \val  {pop-hit}, GAT \val  {gat-hit-mean}.}}{8}{figure.caption.35}\protected@file@percent }
\newlabel{fig:sets}{{2}{8}{Hit@10 thử nghiệm của HAN cho cả 24 tập meta-path, mỗi tập một seed (độ lệch chuẩn qua ba seed của các tập chính nhiều nhất là \val {han-m6-hit-sd}). Ở seed này, các tập tìm được đứng cuối trong số các tập lấy từ cùng \val {search-cands} ứng viên ở cả hai kích thước, dù với chênh lệch nằm trong nhiễu giữa các seed. M5 và M6 nằm gần giữa các tập chọn ngẫu nhiên. Để so sánh: mô hình phổ biến \val {pop-hit}, GAT \val {gat-hit-mean}}{figure.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Chi phí và kết quả của từng cách chọn meta-path cho HAN: Hit@10 trên tập thử nghiệm, lấy mẫu và xếp hạng toàn bộ. Thủ công và bằng tìm kiếm: trung bình qua 3 seed. Ngẫu nhiên: trung bình của 5 lần chọn, mỗi lần một seed. Chênh lệch tương đối được tính so với tập thủ công cùng kích thước. Huấn luyện HAN trên tập đã chọn tốn như nhau cho cả ba cách, trung vị \val  {han-run-min}~phút~GPU mỗi lần chạy.}}{8}{table.caption.36}\protected@file@percent }
\newlabel{tab:cost}{{4}{8}{Chi phí và kết quả của từng cách chọn meta-path cho HAN: Hit@10 trên tập thử nghiệm, lấy mẫu và xếp hạng toàn bộ. Thủ công và bằng tìm kiếm: trung bình qua 3 seed. Ngẫu nhiên: trung bình của 5 lần chọn, mỗi lần một seed. Chênh lệch tương đối được tính so với tập thủ công cùng kích thước. Huấn luyện HAN trên tập đã chọn tốn như nhau cho cả ba cách, trung vị \val {han-run-min}~phút~GPU mỗi lần chạy}{table.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces HAN làm gì với các meta-path: mỗi điểm là một meta-path, đặt theo mức ưa thích trung bình của tìm kiếm đối với nó (cả hai kích thước tập) và trọng số trung bình HAN gán cho nó trên các tập chứa nó (seed 1). Hai bên thống nhất về các meta-path qua người dùng. Hai bên bất đồng về các meta-path danh mục gần rỗng, vốn được tìm kiếm xếp hạng cao còn HAN phần lớn loại bỏ (\val  {kind-empty-dropped} trong \val  {kind-empty-uses} lần dùng có trọng số dưới \val  {weight-drop}) và về các meta-path danh mục dày đặc, vốn bị tìm kiếm xếp hạng thấp còn HAN sử dụng.}}{8}{figure.caption.37}\protected@file@percent }
\newlabel{fig:weights}{{3}{8}{HAN làm gì với các meta-path: mỗi điểm là một meta-path, đặt theo mức ưa thích trung bình của tìm kiếm đối với nó (cả hai kích thước tập) và trọng số trung bình HAN gán cho nó trên các tập chứa nó (seed 1). Hai bên thống nhất về các meta-path qua người dùng. Hai bên bất đồng về các meta-path danh mục gần rỗng, vốn được tìm kiếm xếp hạng cao còn HAN phần lớn loại bỏ (\val {kind-empty-dropped} trong \val {kind-empty-uses} lần dùng có trọng số dưới \val {weight-drop}) và về các meta-path danh mục dày đặc, vốn bị tìm kiếm xếp hạng thấp còn HAN sử dụng}{figure.caption.37}{}}
